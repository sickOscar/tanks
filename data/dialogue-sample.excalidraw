      "updated": 1739894798652,
      "link": null,
      "locked": false,
      "text": "Bravo è l'atteggiamento giusto.\nEcco un libro magico. Ma ora\nsmamma e ritorna quando sarai\npiù saggio",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t2Se5jhuB5TexH7UsHT8D",
      "originalText": "Bravo è l'atteggiamento giusto. Ecco un libro magico. Ma ora smamma e ritorna quando sarai più saggio",
      "autoResize": true,
      "lineHeight": 1.25
    },
