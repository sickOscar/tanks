      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1063.5036824544236,
      "y": 2286.645833333333,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 883.6593017578125,
