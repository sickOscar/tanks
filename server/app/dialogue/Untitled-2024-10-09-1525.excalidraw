      "boundElements": [],
      "updated": 1728636163817,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "Sei proprio un intenditore!\n\n    Il cappello Anti-pensieri! Una volta l'ha indossato un re e... puff! Ha \ndimenticato tutto, anche come si usa una forchetta. \n\n    Il regno è passato alle zuppe per un anno intero.\n",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "k-23zbN4tGtjUx564xYdL",
      "originalText": "Sei proprio un intenditore!\n\n    Il cappello Anti-pensieri! Una volta l'ha indossato un re e... puff! Ha dimenticato tutto, anche come si usa una forchetta. \n\n    Il regno è passato alle zuppe per un anno intero.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
